{
  "$description": "PortalPilot design tokens. Source of truth for tokens.css and tokens.ts (npm run tokens). Semantic tokens are what components use; each theme maps them to values. Contrast pairs are checked in CI (npm run tokens:check).",
  "theme": {
    "dark": {
      "bg": "#0e1116",
      "surface": "#161b22",
      "surface-2": "#1c222b",
      "line": "#2a313c",
      "text": "#e6e9ee",
      "text-muted": "#8b95a5",
      "accent": "#5b9dff",
      "on-accent": "#0b1220",
      "ok": "#3fb97b",
      "warn": "#e3a33b",
      "bad": "#ef6461",
      "operator": "#f2c94c",
      "tier-cache": "#4fc1c9",
      "tier-qwen": "#b18cff",
      "tier-claude": "#e8915a",
      "tier-dom": "#8b95a5",
      "on-tier": "#111111",
      "media-bg": "#000000",
      "on-warn": "#111111"
    },
    "light": {
      "bg": "#f4f6f9",
      "surface": "#ffffff",
      "surface-2": "#eef1f5",
      "line": "#d9dee6",
      "text": "#18202b",
      "text-muted": "#55606f",
      "accent": "#2563c9",
      "on-accent": "#ffffff",
      "ok": "#1d7a4c",
      "warn": "#8f5b00",
      "bad": "#c0392f",
      "operator": "#7a5d00",
      "tier-cache": "#4fc1c9",
      "tier-qwen": "#b18cff",
      "tier-claude": "#e8915a",
      "tier-dom": "#a3acb9",
      "on-tier": "#111111",
      "media-bg": "#000000",
      "on-warn": "#ffffff"
    }
  },
  "contrast": {
    "$description": "[foreground, background, minimum ratio]. 4.5 = WCAG AA body text; 3 = AA large text and UI components.",
    "pairs": [
      [
        "text",
        "bg",
        4.5
      ],
      [
        "text",
        "surface",
        4.5
      ],
      [
        "text",
        "surface-2",
        4.5
      ],
      [
        "text-muted",
        "bg",
        4.5
      ],
      [
        "text-muted",
        "surface",
        4.5
      ],
      [
        "accent",
        "surface",
        4.5
      ],
      [
        "on-accent",
        "accent",
        4.5
      ],
      [
        "ok",
        "surface",
        4.5
      ],
      [
        "warn",
        "surface",
        4.5
      ],
      [
        "bad",
        "surface",
        4.5
      ],
      [
        "operator",
        "surface",
        4.5
      ],
      [
        "on-tier",
        "tier-cache",
        4.5
      ],
      [
        "on-tier",
        "tier-qwen",
        4.5
      ],
      [
        "on-tier",
        "tier-claude",
        4.5
      ],
      [
        "on-tier",
        "tier-dom",
        4.5
      ],
      [
        "on-warn",
        "warn",
        4.5
      ],
      [
        "line",
        "surface",
        1.2
      ]
    ]
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "pill": "999px"
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "ui-monospace, \"Cascadia Code\", \"JetBrains Mono\", Menlo, monospace",
    "size-xs": "11px",
    "size-sm": "12px",
    "size-md": "14px",
    "size-lg": "15px",
    "size-xl": "20px",
    "size-stat": "26px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms"
  }
}
