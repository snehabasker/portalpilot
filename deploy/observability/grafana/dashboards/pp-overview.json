    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Double-submit suspects",
   "description": "Ledger rows whose submit button was pressed more than once. Each is checked on the portal.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "portalpilot_double_submit_suspects",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3fb97b",
        "value": null
       },
       {
        "color": "#ef6461",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
