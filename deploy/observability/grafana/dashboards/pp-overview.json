  {
   "type": "stat",
   "title": "API availability (30 d, objective 99.5 %)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - (sum(increase(portalpilot_http_requests_total{code=~\"5..\"}[30d])) / clamp_min(sum(increase(portalpilot_http_requests_total[30d])), 1))",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#ef6461",
        "value": null
       },
       {
        "color": "#e3a33b",
        "value": 0.995
       },
       {
        "color": "#3fb97b",
        "value": 0.998
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 6,
    "h": 4
   },
   "id": 9
  },
  {
   "type": "stat",
   "title": "API error budget left (30 d)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - (sum(increase(portalpilot_http_requests_total{code=~\"5..\"}[30d])) / clamp_min(sum(increase(portalpilot_http_requests_total[30d])), 1)) / (1 - 0.995)",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#ef6461",
        "value": null
       },
       {
        "color": "#e3a33b",
        "value": 0.25
       },
       {
        "color": "#3fb97b",
        "value": 0.5
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "gridPos": {
    "x": 6,
    "y": 6,
    "w": 6,
    "h": 4
   },
   "id": 10
  },
  {
