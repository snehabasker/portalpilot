{
 "uid": "pp-overview",
 "title": "PortalPilot: service overview",
 "description": "On-call view: correctness invariants, SLOs and error budgets, and what humans are waiting on.",
 "tags": [
  "portalpilot"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Correctness (any non-zero value pages)",
