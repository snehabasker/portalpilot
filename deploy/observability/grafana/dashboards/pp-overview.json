  {
   "type": "timeseries",
   "title": "API error ratio vs fast-burn threshold",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "slo:api_errors:ratio_rate5m",
     "legendFormat": "5 m",
     "refId": "A"
    },
    {
     "expr": "slo:api_errors:ratio_rate1h",
     "legendFormat": "1 h",
     "refId": "B"
    },
    {
     "expr": "vector(14.4 * (1 - 0.995))",
     "legendFormat": "page threshold",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "page threshold"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ef6461"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "id": 13
  },
