   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - sum(increase(portalpilot_grounding_failed_total[30d])) / clamp_min(sum(increase(portalpilot_grounding_attempts_total{result=\"verified\"}[30d])) + sum(increase(portalpilot_grounding_failed_total[30d])), 1)",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
