{
 "uid": "pp-agent",
 "title": "PortalPilot: agent internals",
 "description": "Where time and money go inside a claim: stages, grounding tiers, escalations.",
 "tags": [
  "portalpilot"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Stages",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Stage attempts by outcome",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (outcome) (portalpilot:stage_attempts:rate10m)",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 25,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ok"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3fb97b"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "needs_human"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e3a33b"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "retryable_error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8915a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "fatal_error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ef6461"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Retryable stage errors (portal health)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "portalpilot:stage_retryable_errors:ratio_rate10m",
     "legendFormat": "ratio",
     "refId": "A"
    },
    {
     "expr": "vector(0.3)",
     "legendFormat": "ticket threshold",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ticket threshold"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e3a33b"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "p95 stage duration",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(portalpilot_stage_duration_seconds_bucket{outcome=\"ok\"}[10m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 8
   },
   "id": 4
